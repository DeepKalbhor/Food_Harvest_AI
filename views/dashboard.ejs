
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Food Harvest AI | Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root {
    --bg: #f7f8f5;
    --surface: #ffffff;
    --ink: #202923;
    --muted: #78827a;
    --line: #e9ede8;
    --green: #236b45;
    --green-dark: #194d34;
    --green-soft: #edf5ef;
    --red: #a84c45;
    --amber: #a66b19;
    --shadow: 0 8px 30px rgba(28,48,34,.045);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
                 "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
}

a {
    color: inherit;
    text-decoration: none;
}

/* NAVIGATION */

.topbar {
    height: 76px;
    background: rgba(255,255,255,.95);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
}

.topbar-inner {
    width: min(1320px, calc(100% - 64px));
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-mark {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--green);
    color: white;
    font-size: 18px;
}

.brand-name {
    font-size: 15px;
    font-weight: 700;
}

.brand-name span {
    color: var(--green);
}

.nav {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nav a {
    color: #69746c;
    font-size: 13px;
    font-weight: 550;
    padding: 10px 13px;
    border-radius: 8px;
    transition: .2s;
}

.nav a:hover,
.nav a.active {
    background: var(--green-soft);
    color: var(--green-dark);
}

.avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #e9efe9;
    color: var(--green-dark);
    font-size: 12px;
    font-weight: 700;
}

/* MAIN */

main {
    width: min(1320px, calc(100% - 64px));
    margin: 42px auto 64px;
}

.heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 30px;
}

.eyebrow {
    color: var(--green);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 10px;
    font-weight: 750;
    margin-bottom: 10px;
}

h1 {
    font-size: clamp(27px, 3vw, 34px);
    letter-spacing: -1.2px;
    margin: 0;
    font-weight: 650;
}

.heading p {
    color: var(--muted);
    font-size: 13px;
    margin: 9px 0 0;
}

.actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.updated {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
}

button {
    border: 1px solid var(--line);
    background: white;
    color: var(--ink);
    padding: 10px 14px;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
    transition: .2s;
}

button:hover {
    border-color: #c7d8ca;
    background: #fbfdfb;
}

button:disabled {
    opacity: .55;
    cursor: wait;
}

.refresh-icon {
    color: var(--green);
    margin-right: 5px;
}

/* KPI CARDS */

.kpis {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 18px;
}

.kpi,
.panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 13px;
    box-shadow: var(--shadow);
}

.kpi {
    padding: 20px;
    min-height: 132px;
}

.kpi-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.kpi-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 550;
}

.kpi-icon {
    width: 29px;
    height: 29px;
    border-radius: 8px;
    background: var(--green-soft);
    color: var(--green);
    display: grid;
    place-items: center;
    font-size: 14px;
}

.kpi-value {
    font-size: 30px;
    font-weight: 650;
    letter-spacing: -1px;
    margin-top: 15px;
}

.kpi-note {
    color: #9aa39c;
    font-size: 10px;
    margin-top: 4px;
}

/* CHARTS */

.main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(300px, .9fr);
    gap: 16px;
    margin-bottom: 16px;
}

.panel {
    padding: 22px;
    min-width: 0;
}

.panel-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 18px;
}

.panel-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -.2px;
    margin: 0;
}

.panel-subtitle {
    color: var(--muted);
    font-size: 11px;
    margin: 6px 0 0;
}

.pill {
    border: 1px solid var(--line);
    background: #fbfcfa;
    color: var(--muted);
    border-radius: 30px;
    padding: 6px 10px;
    font-size: 10px;
    white-space: nowrap;
}

.chart-box {
    height: 260px;
    position: relative;
}

.chart-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 16px;
}

.chart-box.small {
    height: 225px;
}

/* RECENT ORDERS */

.table-panel {
    padding: 0;
    overflow: hidden;
}

.table-head {
    padding: 22px 22px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
}

.table-wrap {
    overflow-x: auto;
}

table {
    border-collapse: collapse;
    width: 100%;
    min-width: 540px;
}

th {
    text-align: left;
    padding: 12px 22px;
    color: #929b94;
    background: #fafbf9;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-transform: uppercase;
    letter-spacing: .8px;
    font-size: 9px;
    font-weight: 700;
}

td {
    padding: 15px 22px;
    border-bottom: 1px solid #f0f2ef;
    font-size: 12px;
    color: #4e5a51;
}

tbody tr:last-child td {
    border-bottom: 0;
}

tbody tr:hover {
    background: #fcfdfb;
}

.order-id {
    color: var(--ink);
    font-weight: 700;
}

.status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 30px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 650;
    background: #f0f3f0;
    color: #647067;
    white-space: nowrap;
}

.status::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
}

.status.delivered {
    background: #edf6ef;
    color: #287448;
}

.status.cancelled {
    background: #fbefee;
    color: #a84c45;
}

.status.transit,
.status.picked {
    background: #fdf5e9;
    color: #9b6a20;
}

.status.accepted,
.status.assigned {
    background: #eef3fa;
    color: #55759d;
}

.empty {
    text-align: center;
    color: var(--muted);
    padding: 30px;
}

.notice {
    margin: 13px 22px;
    color: var(--muted);
    font-size: 11px;
    min-height: 16px;
}

.notice.error {
    color: var(--red);
}

.footer {
    text-align: center;
    color: #9aa39c;
    font-size: 10px;
    padding: 22px 16px 30px;
}

/* RESPONSIVE */

@media (max-width: 1050px) {
    .kpis {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 760px) {
    .topbar {
        height: auto;
        padding: 15px 0;
    }

    .topbar-inner {
        width: calc(100% - 32px);
        flex-wrap: wrap;
    }

    .nav {
        order: 3;
        width: 100%;
        overflow-x: auto;
    }

    .nav a {
        white-space: nowrap;
    }

    main {
        width: calc(100% - 32px);
        margin-top: 28px;
    }

    .heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .actions {
        width: 100%;
        justify-content: space-between;
    }

    .main-grid,
    .chart-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 480px) {
    .kpis {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .kpi {
        padding: 15px;
        min-height: 120px;
    }

    .kpi-value {
        font-size: 26px;
    }

    .panel {
        padding: 17px;
    }

    .table-head {
        padding: 18px 17px 14px;
    }

    th, td {
        padding-left: 15px;
        padding-right: 15px;
    }

    .updated {
        display: none;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<header class="topbar">
    <div class="topbar-inner">

        <a class="brand" href="/">
            <div class="brand-mark">✳</div>
            <div class="brand-name">Food Harvest <span>AI</span></div>
        </a>

        <nav class="nav">
            <a href="/">Home</a>
            <a href="/donate">Donate Food</a>
            <a href="/matching">NGO Matching</a>
            <a href="/orders">Manage Orders</a>
            <a class="active" href="/dashboard">Dashboard</a>
        </nav>

        <div class="avatar">FH</div>

    </div>
</header>

<main>

    <!-- PAGE HEADING -->
    <section class="heading">

        <div>
            <div class="eyebrow">Overview</div>
            <h1>Dashboard</h1>
            <p>A clear view of donations, orders and delivery activity.</p>
        </div>

        <div class="actions">
            <span class="updated" id="lastUpdated">
                Updating data…
            </span>

            <button id="refreshButton"
                    type="button"
                    onclick="loadDashboard()">
                <span class="refresh-icon">↻</span> Refresh
            </button>
        </div>

    </section>

    <!-- KPI CARDS -->
    <section class="kpis">

        <article class="kpi">
            <div class="kpi-top">
                <span class="kpi-label">Total donations</span>
                <span class="kpi-icon">♧</span>
            </div>
            <div class="kpi-value" id="donations">—</div>
            <div class="kpi-note">All recorded donations</div>
        </article>

        <article class="kpi">
            <div class="kpi-top">
                <span class="kpi-label">Available</span>
                <span class="kpi-icon">＋</span>
            </div>
            <div class="kpi-value" id="available">—</div>
            <div class="kpi-note">Ready for matching</div>
        </article>

        <article class="kpi">
            <div class="kpi-top">
                <span class="kpi-label">Total orders</span>
                <span class="kpi-icon">▤</span>
            </div>
            <div class="kpi-value" id="orders">—</div>
            <div class="kpi-note">Orders created</div>
        </article>

        <article class="kpi">
            <div class="kpi-top">
                <span class="kpi-label">Delivered</span>
                <span class="kpi-icon">✓</span>
            </div>
            <div class="kpi-value" id="delivered">—</div>
            <div class="kpi-note">Successfully completed</div>
        </article>

        <article class="kpi">
            <div class="kpi-top">
                <span class="kpi-label">Cancelled</span>
                <span class="kpi-icon">−</span>
            </div>
            <div class="kpi-value" id="cancelled">—</div>
            <div class="kpi-note">Cancelled orders</div>
        </article>

    </section>

    <!-- MAIN CHARTS -->
    <section class="main-grid">

        <article class="panel">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">Donation availability</h2>
                    <p class="panel-subtitle">
                        Available donations compared with other statuses
                    </p>
                </div>
                <span class="pill">Donations</span>
            </div>

            <div class="chart-box">
                <canvas id="donationChart"></canvas>
            </div>
        </article>

        <article class="panel">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">Order status</h2>
                    <p class="panel-subtitle">
                        Current distribution across orders
                    </p>
                </div>
                <span class="pill">Orders</span>
            </div>

            <div class="chart-box">
                <canvas id="orderChart"></canvas>
            </div>
        </article>

    </section>

    <!-- ANALYTICS CHARTS -->
    <section class="chart-grid">

        <article class="panel">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">Donations vs orders</h2>
                    <p class="panel-subtitle">Overall platform activity</p>
                </div>
                <span class="pill">Comparison</span>
            </div>

            <div class="chart-box small">
                <canvas id="comparisonChart"></canvas>
            </div>
        </article>

        <article class="panel">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">Order progress</h2>
                    <p class="panel-subtitle">
                        Completed, active and cancelled
                    </p>
                </div>
                <span class="pill">Fulfilment</span>
            </div>

            <div class="chart-box small">
                <canvas id="progressChart"></canvas>
            </div>
        </article>

    </section>

    <!-- RECENT ORDERS -->
    <section class="panel table-panel">

        <div class="table-head">
            <div>
                <h2 class="panel-title">Recent orders</h2>
                <p class="panel-subtitle">
                    Latest activity recorded on the platform
                </p>
            </div>

            <a href="/orders">
                <button type="button">Manage orders ↗</button>
            </a>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody id="recent">
                    <tr>
                        <td colspan="3" class="empty">
                            Loading orders…
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p id="message" class="notice" role="status" aria-live="polite"></p>

    </section>

</main>

<footer class="footer">
    Food Harvest AI · Making surplus food go further.
</footer>

<script>

let donationChart;
let orderChart;
let comparisonChart;
let progressChart;

const chartColors = {
    green: "#286f49",
    pale: "#b9d4c0",
    amber: "#d5a45a",
    red: "#c87970",
    blue: "#829bb9",
    grey: "#dfe6df"
};

// CHART OPTIONS
function chartOptions(type) {

    return {
        responsive: true,
        maintainAspectRatio: false,

        cutout: type === "doughnut" ? "72%" : undefined,

        plugins: {
            legend: {
                display: type === "doughnut",
                position: "bottom",

                labels: {
                    usePointStyle: true,
                    pointStyle: "circle",
                    boxWidth: 7,
                    boxHeight: 7,
                    padding: 18,
                    color: "#778279",
                    font: {
                        size: 10
                    }
                }
            },

            tooltip: {
                backgroundColor: "#202923",
                padding: 11,
                cornerRadius: 8
            }
        },

        scales: type === "bar" ? {

            x: {
                grid: {
                    display: false
                },
                ticks: {
                    color: "#89938b",
                    font: {
                        size: 10
                    }
                },
                border: {
                    display: false
                }
            },

            y: {
                beginAtZero: true,

                grid: {
                    color: "#eef1ed"
                },

                ticks: {
                    precision: 0,
                    color: "#89938b",
                    font: {
                        size: 10
                    }
                },

                border: {
                    display: false
                }
            }

        } : {}
    };
}

// CREATE CHART
function createChart(id, type, labels, values, colors) {

    return new Chart(document.getElementById(id), {

        type,

        data: {
            labels,

            datasets: [{
                data: values,
                backgroundColor: colors,
                borderWidth: 0,
                borderRadius: type === "bar" ? 6 : 0,
                hoverOffset: type === "doughnut" ? 4 : 0,
                barPercentage: .55,
                categoryPercentage: .65
            }]
        },

        options: chartOptions(type)

    });
}

// UPDATE EXISTING CHART
function setChart(chart, labels, values) {

    chart.data.labels = labels;
    chart.data.datasets[0].data = values;

    chart.update();
}

// STATUS COLORS
function statusClass(status) {

    const s = String(status || "").toLowerCase();

    if (s.includes("deliver")) return "delivered";
    if (s.includes("cancel")) return "cancelled";
    if (s.includes("transit")) return "transit";
    if (s.includes("pick")) return "picked";
    if (s.includes("accept")) return "accepted";
    if (s.includes("assign")) return "assigned";

    return "";
}

// DISPLAY RECENT ORDERS
function renderRecentOrders(recent) {

    const tbody = document.getElementById("recent");

    tbody.replaceChildren();

    if (!recent.length) {

        const row = tbody.insertRow();
        const cell = row.insertCell();

        cell.colSpan = 3;
        cell.className = "empty";
        cell.textContent = "No orders found yet.";

        return;
    }

    recent.forEach(order => {

        const row = tbody.insertRow();

        const id = row.insertCell();

        id.className = "order-id";
        id.textContent = order.order_id ?? "—";

        const statusCell = row.insertCell();

        const badge = document.createElement("span");

        badge.className =
            "status " + statusClass(order.order_status);

        badge.textContent =
            order.order_status ?? "Unknown";

        statusCell.appendChild(badge);

        const date = row.insertCell();

        date.textContent = order.created_at
            ? new Date(order.created_at).toLocaleString()
            : "—";

    });
}

// LOAD DASHBOARD DATA
async function loadDashboard() {

    const button = document.getElementById("refreshButton");
    const message = document.getElementById("message");

    button.disabled = true;
    button.textContent = "Loading…";

    message.textContent = "";
    message.className = "notice";

    try {

        const response = await fetch("/api/dashboard", {
            cache: "no-store"
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message || "Unable to load dashboard data."
            );
        }

        const donations = data.donations || {};
        const orders = data.orders || {};

        const recent = Array.isArray(data.recent)
            ? data.recent
            : [];

        // KPI VALUES
        const totalDonations =
            Number(donations.total) || 0;

        const availableDonations =
            Number(donations.available) || 0;

        const totalOrders =
            Number(orders.total) || 0;

        const deliveredOrders =
            Number(orders.delivered) || 0;

        const cancelledOrders =
            Number(orders.cancelled) || 0;

        const otherDonations = Math.max(
            0,
            totalDonations - availableDonations
        );

        const activeOrders = Math.max(
            0,
            totalOrders - deliveredOrders - cancelledOrders
        );

        // UPDATE KPI CARDS
        document.getElementById("donations").textContent =
            totalDonations.toLocaleString();

        document.getElementById("available").textContent =
            availableDonations.toLocaleString();

        document.getElementById("orders").textContent =
            totalOrders.toLocaleString();

        document.getElementById("delivered").textContent =
            deliveredOrders.toLocaleString();

        document.getElementById("cancelled").textContent =
            cancelledOrders.toLocaleString();

        // CREATE CHARTS
        if (!donationChart) {

            donationChart = createChart(
                "donationChart",
                "doughnut",
                ["Available", "Other statuses"],
                [availableDonations, otherDonations],
                [chartColors.green, chartColors.grey]
            );

            orderChart = createChart(
                "orderChart",
                "doughnut",
                ["Delivered", "Active", "Cancelled"],
                [deliveredOrders, activeOrders, cancelledOrders],
                [
                    chartColors.green,
                    chartColors.amber,
                    chartColors.red
                ]
            );

            comparisonChart = createChart(
                "comparisonChart",
                "bar",
                ["Donations", "Orders"],
                [totalDonations, totalOrders],
                [chartColors.green, chartColors.pale]
            );

            progressChart = createChart(
                "progressChart",
                "bar",
                ["Delivered", "Active", "Cancelled"],
                [deliveredOrders, activeOrders, cancelledOrders],
                [
                    chartColors.green,
                    chartColors.amber,
                    chartColors.red
                ]
            );

        } else {

            // UPDATE CHARTS
            setChart(
                donationChart,
                ["Available", "Other statuses"],
                [availableDonations, otherDonations]
            );

            setChart(
                orderChart,
                ["Delivered", "Active", "Cancelled"],
                [deliveredOrders, activeOrders, cancelledOrders]
            );

            setChart(
                comparisonChart,
                ["Donations", "Orders"],
                [totalDonations, totalOrders]
            );

            setChart(
                progressChart,
                ["Delivered", "Active", "Cancelled"],
                [deliveredOrders, activeOrders, cancelledOrders]
            );

        }

        // UPDATE RECENT ORDERS
        renderRecentOrders(recent);

        // LAST UPDATED
        document.getElementById("lastUpdated").textContent =
            "Updated " +
            new Date().toLocaleTimeString([], {
                hour: "2-digit",
                minute: "2-digit"
            });

        message.textContent = "Dashboard data is up to date.";

    } catch (error) {

        console.error("Dashboard error:", error);

        message.textContent =
            "Unable to load dashboard: " + error.message;

        message.className = "notice error";

    } finally {

        button.disabled = false;

        button.innerHTML =
            '<span class="refresh-icon">↻</span> Refresh';

    }
}

// INITIAL LOAD
loadDashboard();

</script>

</body>
</html>
