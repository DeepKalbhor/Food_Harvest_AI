
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delivery Partner | Food Harvest AI</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
<div class="tracking-page">
    <header class="tracking-header">
        <div class="tracking-title">
            <h2>🚚 Delivery Partner</h2>
            <p>Tracking room: <%= orderId %></p>
        </div>
        <div class="status">
            <span id="statusDot" class="status-dot"></span>
            <span id="statusText">Connecting...</span>
        </div>
    </header>

    <div class="map-wrapper">
        <div id="map"></div>

        <div class="map-card">
            <h3>📡 Your Live Location</h3>
            <div class="map-info"><span>GPS</span><span id="gpsStatus">Waiting...</span></div>
            <div class="map-info"><span>Latitude</span><span id="latitude">--</span></div>
            <div class="map-info"><span>Longitude</span><span id="longitude">--</span></div>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
const socket = io();
const roomId = <%- JSON.stringify(String(orderId)) %>;

const map = L.map("map").setView([23.157272, 72.670295], 13);

L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap contributors"
}).addTo(map);

const truckIcon = L.divIcon({
    className: "",
    html: '<div class="delivery-marker">🚚</div>',
    iconSize: [42, 42],
    iconAnchor: [21, 21]
});

let marker = null;

socket.on("connect", () => {
    document.getElementById("statusDot").classList.add("connected");
    document.getElementById("statusText").textContent = "Connected";

    socket.emit("join-order", {
        orderId: roomId,
        role: "delivery"
    });

    console.log("Delivery joined room:", roomId);
});

socket.on("disconnect", () => {
    document.getElementById("statusDot").classList.remove("connected");
    document.getElementById("statusText").textContent = "Disconnected";
});

function showLocation(latitude, longitude) {
    const point = [latitude, longitude];

    if (!marker) {
        marker = L.marker(point, { icon: truckIcon })
            .addTo(map)
            .bindPopup("🚚 Delivery Partner");
        marker.openPopup();
    } else {
        marker.setLatLng(point);
    }

    map.setView(point, 16);

    document.getElementById("latitude").textContent = latitude.toFixed(6);
    document.getElementById("longitude").textContent = longitude.toFixed(6);
    document.getElementById("gpsStatus").textContent = "Active";

    console.log("GPS location:", latitude, longitude);
}

function gpsError(error) {
    console.error("GPS error:", error.code, error.message);
    document.getElementById("gpsStatus").textContent = error.message;
}

if ("geolocation" in navigator) {
    navigator.geolocation.watchPosition(
        position => {
            const latitude = position.coords.latitude;
            const longitude = position.coords.longitude;

            showLocation(latitude, longitude);

            socket.emit("send-location", {
                latitude,
                longitude
            });
        },
        gpsError,
        {
            enableHighAccuracy: true,
            timeout: 15000,
            maximumAge: 3000
        }
    );
} else {
    document.getElementById("gpsStatus").textContent = "GPS unsupported";
}

window.addEventListener("load", () => {
    setTimeout(() => map.invalidateSize(true), 300);
});
</script>
</body>
</html>
