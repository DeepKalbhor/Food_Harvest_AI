<!DOCTYPE html>

<html>

<head>

    <title>Delivery Partner</title>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <style>

        body {
            margin: 0;
            font-family: Arial;
        }

        h2 {
            text-align: center;
        }

        #map {
            height: 80vh;
        }

    </style>

</head>


<body>

    <h2>
        Delivery Partner
    </h2>

    <p style="text-align:center">
        Order ID: <%= orderId %>
    </p>

    <div id="map"></div>


    <script src="/socket.io/socket.io.js"></script>

    <script
        src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>


    <script>

        const socket = io();

        const orderId = "<%= orderId %>";

        const role = "delivery";


        console.log(
            "Delivery:",
            orderId
        );


        // Join order
        socket.emit(
            "join-order",
            {
                orderId: orderId,
                role: role
            }
        );


        // Create map
        const map = L.map("map")
            .setView([0, 0], 10);


        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    "© OpenStreetMap contributors"
            }
        ).addTo(map);


        // Get delivery partner location
        if (navigator.geolocation) {

            navigator.geolocation.watchPosition(

                function(position) {

                    const latitude =
                        position.coords.latitude;

                    const longitude =
                        position.coords.longitude;


                    console.log(
                        "Sending:",
                        latitude,
                        longitude
                    );


                    socket.emit(
                        "send-location",
                        {
                            latitude: latitude,
                            longitude: longitude
                        }
                    );


                    // Show delivery partner's
                    // own location
                    map.setView(
                        [latitude, longitude],
                        16
                    );

                },


                function(error) {

                    console.error(
                        "Location error:",
                        error
                    );

                },


                {
                    enableHighAccuracy: true,
                    timeout: 5000,
                    maximumAge: 0
                }

            );

        }

    </script>

</body>

</html>