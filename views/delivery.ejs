
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delivery Partner | Food Harvest AI</title>

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f8f5;
            color: #183b2b;
        }

        header {
            background: #176b45;
            color: white;
            padding: 18px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        header h2 {
            font-size: 22px;
        }

        .container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 18px;
        }

        .card {
            background: white;
            padding: 22px;
            border-radius: 14px;
            margin-bottom: 20px;
            box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        }

        .details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 18px;
            margin-top: 15px;
        }

        .detail-box {
            background: #f1f8f3;
            padding: 15px;
            border-radius: 10px;
        }

        .detail-box small {
            color: #64756b;
            display: block;
            margin-bottom: 7px;
        }

        .detail-box strong {
            font-size: 15px;
            overflow-wrap: anywhere;
        }

        #map {
            height: 450px;
            width: 100%;
            border-radius: 12px;
            z-index: 1;
        }

        .status {
            margin: 15px 0;
            padding: 12px;
            border-radius: 8px;
            background: #fff7df;
            color: #815d00;
        }

        .status.active {
            background: #e3f7e9;
            color: #176b45;
        }

        .status.error {
            background: #ffe8e8;
            color: #a32121;
        }

        button {
            border: none;
            padding: 13px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 15px;
            font-weight: bold;
            margin: 5px 5px 5px 0;
        }

        #startBtn {
            background: #176b45;
            color: white;
        }

        #stopBtn {
            background: #b83232;
            color: white;
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .muted {
            color: #64756b;
            font-size: 13px;
            margin-top: 10px;
        }

        @media(max-width: 600px) {
            #map {
                height: 350px;
            }
        }
    </style>
</head>

<body>

<header>
    <h2>Food Harvest AI</h2>
    <span>Delivery Partner Panel</span>
</header>

<div class="container">

    <div class="card">
        <h2>Delivery Information</h2>

        <div class="details">
            <div class="detail-box">
                <small>Order ID</small>
                <strong id="orderId">Loading...</strong>
            </div>

            <div class="detail-box">
                <small>Food</small>
                <strong id="foodName">Loading...</strong>
            </div>

            <div class="detail-box">
                <small>Restaurant</small>
                <strong id="restaurantName">Loading...</strong>
            </div>

            <div class="detail-box">
                <small>NGO</small>
                <strong id="ngoName">Loading...</strong>
            </div>

            <div class="detail-box">
                <small>Pickup Address</small>
                <strong id="pickupAddress">Loading...</strong>
            </div>

            <div class="detail-box">
                <small>Delivery Address</small>
                <strong id="ngoAddress">Loading...</strong>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Live Location Sharing</h2>

        <div id="status" class="status">
            Loading delivery information...
        </div>

        <button id="startBtn" disabled>
            Start Sharing Location
        </button>

        <button id="stopBtn" disabled>
            Stop Sharing
        </button>

        <p class="muted">
            Keep this page open while travelling. Your browser must have
            location permission enabled.
        </p>

        <p class="muted" id="coordinates">
            Current coordinates: Not available
        </p>
    </div>

    <div class="card">
        <h2>Delivery Route</h2>
        <p class="muted">
            Blue: Restaurant | Green: NGO | Red: Delivery Partner
        </p>
        <br>
        <div id="map"></div>
    </div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    const orderId = <%- JSON.stringify(orderId) %>;

    const statusBox = document.getElementById("status");
    const startBtn = document.getElementById("startBtn");
    const stopBtn = document.getElementById("stopBtn");

    let socket;
    let watchId = null;
    let map;
    let pickupMarker = null;
    let ngoMarker = null;
    let driverMarker = null;
    let routeLine = null;

    let pickupLocation = null;
    let ngoLocation = null;
    let deliveryDataLoaded = false;

    function setStatus(message, type = "") {
        statusBox.textContent = message;
        statusBox.className = "status " + type;
    }

    function validCoordinates(lat, lng) {
        return Number.isFinite(lat) &&
               Number.isFinite(lng) &&
               lat >= -90 && lat <= 90 &&
               lng >= -180 && lng <= 180 &&
               !(lat === 0 && lng === 0);
    }

    function initializeMap() {
        map = L.map("map").setView([20.5937, 78.9629], 5);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);
    }

    function addRoute() {
        if (!pickupLocation || !ngoLocation) return;

        if (pickupMarker) map.removeLayer(pickupMarker);
        if (ngoMarker) map.removeLayer(ngoMarker);
        if (routeLine) map.removeLayer(routeLine);

        pickupMarker = L.marker(pickupLocation)
            .addTo(map)
            .bindPopup("Restaurant Pickup");

        ngoMarker = L.marker(ngoLocation)
            .addTo(map)
            .bindPopup("NGO Destination");

        routeLine = L.polyline(
            [pickupLocation, ngoLocation],
            { color: "green", weight: 4, dashArray: "8, 8" }
        ).addTo(map);

        map.fitBounds(
            L.latLngBounds([pickupLocation, ngoLocation]),
            { padding: [40, 40] }
        );
    }

    function updateDriverLocation(lat, lng) {
        if (!validCoordinates(lat, lng)) return;

        const position = [lat, lng];

        if (!driverMarker) {
            driverMarker = L.marker(position)
                .addTo(map)
                .bindPopup("Delivery Partner");
        } else {
            driverMarker.setLatLng(position);
        }

        document.getElementById("coordinates").textContent =
            `Current coordinates: ${lat.toFixed(6)}, ${lng.toFixed(6)}`;
    }

    async function loadDelivery() {
        try {
            const response = await fetch(
                `/api/delivery/${encodeURIComponent(orderId)}`
            );

            const result = await response.json();

            if (!response.ok) {
                throw new Error(result.message || "Unable to load delivery.");
            }

            const d = result.delivery || result.data || result;

            document.getElementById("orderId").textContent =
                d.order_id || orderId;

            document.getElementById("foodName").textContent =
                d.food_name || "Food donation";

            document.getElementById("restaurantName").textContent =
                d.restaurant_name || "Restaurant";

            document.getElementById("ngoName").textContent =
                d.ngo_name || "NGO";

            document.getElementById("pickupAddress").textContent =
                d.pickup_address || "Not available";

            document.getElementById("ngoAddress").textContent =
                d.ngo_address || "Not available";

            const pickupLat = Number(d.pickup_latitude);
            const pickupLng = Number(d.pickup_longitude);

            const ngoLat = Number(d.ngo_latitude);
            const ngoLng = Number(d.ngo_longitude);

            if (!validCoordinates(pickupLat, pickupLng)) {
                throw new Error("Restaurant pickup coordinates are missing or invalid.");
            }

            if (!validCoordinates(ngoLat, ngoLng)) {
                throw new Error("NGO destination coordinates are missing or invalid.");
            }

            pickupLocation = [pickupLat, pickupLng];
            ngoLocation = [ngoLat, ngoLng];

            addRoute();

            deliveryDataLoaded = true;
            startBtn.disabled = false;

            setStatus("Delivery loaded. You can start sharing your location.");

        } catch (error) {
            console.error("Delivery loading error:", error);
            setStatus(error.message, "error");
        }
    }

    function connectSocket() {
        socket = io();

        socket.on("connect", () => {
            socket.emit("join-order", {
                orderId: orderId,
                role: "delivery"
            });
        });

        socket.on("connect_error", (error) => {
            console.error("Socket connection error:", error);
            setStatus("Live connection failed. Reconnecting...", "error");
        });
    }

    function startSharing() {
        if (!deliveryDataLoaded) {
            setStatus("Delivery information is not ready.", "error");
            return;
        }

        if (!navigator.geolocation) {
            setStatus("Geolocation is not supported by this browser.", "error");
            return;
        }

        if (!socket || !socket.connected) {
            setStatus("Connecting to live tracking server. Please try again.", "error");
            return;
        }

        if (watchId !== null) return;

        setStatus("Requesting GPS location...");

        watchId = navigator.geolocation.watchPosition(
            (position) => {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;

                if (!validCoordinates(lat, lng)) {
                    setStatus("Received invalid GPS coordinates.", "error");
                    return;
                }

                updateDriverLocation(lat, lng);

                socket.emit("send-location", {
                    orderId: orderId,
                    latitude: lat,
                    longitude: lng
                });

                setStatus("Your live location is being shared.", "active");

                startBtn.disabled = true;
                stopBtn.disabled = false;
            },
            (error) => {
                console.error("GPS error:", error);

                const messages = {
                    1: "Location permission denied. Please allow location access.",
                    2: "GPS position is unavailable. Check your device location.",
                    3: "GPS request timed out. Please try again."
                };

                setStatus(
                    messages[error.code] || "Unable to access GPS.",
                    "error"
                );

                stopSharing();
            },
            {
                enableHighAccuracy: true,
                maximumAge: 3000,
                timeout: 15000
            }
        );

        startBtn.disabled = true;
        stopBtn.disabled = false;
    }

    function stopSharing() {
        if (watchId !== null) {
            navigator.geolocation.clearWatch(watchId);
            watchId = null;
        }

        startBtn.disabled = !deliveryDataLoaded;
        stopBtn.disabled = true;

        setStatus("Location sharing stopped.");
    }

    startBtn.addEventListener("click", startSharing);
    stopBtn.addEventListener("click", stopSharing);

    initializeMap();
    connectSocket();
    loadDelivery();

    window.addEventListener("beforeunload", () => {
        if (watchId !== null) {
            navigator.geolocation.clearWatch(watchId);
        }
    });
</script>

</body>
</html>
