<script>
document.getElementById("donationForm").addEventListener("submit", async function(e) {
    e.preventDefault();
const donationForm = document.getElementById("donationForm");
const formMessage = document.getElementById("formMessage");
const submitButton = donationForm.querySelector('button[type="submit"]');

donationForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    formMessage.textContent = "";

    const button = this.querySelector('button[type="submit"]');
    const food = document.getElementById("foodName").value.trim();
    const foodName = document.getElementById("foodName").value.trim();
    const category = document.getElementById("category").value;
    const quantity = Number(document.getElementById("quantity").value);
    const unit = document.getElementById("unit").value;
    const location = document.getElementById("location").value.trim();
    const category = document.getElementById("category").value;

    if (!food || !location || !Number.isFinite(quantity) || quantity <= 0) {
        alert("Please enter valid food details.");
    const pickupAddress = document.getElementById("location").value.trim();

    if (
        !foodName ||
        !category ||
        !unit ||
        !pickupAddress ||
        !Number.isFinite(quantity) ||
        quantity <= 0
    ) {
        formMessage.textContent = "Please enter valid donation details.";
        return;
    }

    button.disabled = true;
    button.textContent = "Saving donation...";
    submitButton.disabled = true;
    submitButton.textContent = "Saving donation...";

    try {
        const response = await fetch("/api/donations", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            body: JSON.stringify({
                food_name: food,
                food_name: foodName,
                category: category,
                quantity: quantity,
                unit: unit,
                pickup_address: location
                pickup_address: pickupAddress
            })
        });

        const result = await response.json();
        const responseText = await response.text();
        let result;

        if (!response.ok) {
            throw new Error(result.error || "Could not save donation.");
        try {
            result = JSON.parse(responseText);
        } catch {
            console.error("Unexpected server response:", responseText);
            throw new Error(
                "The server did not return JSON. Check the Render logs and API route."
            );
        }

        sessionStorage.setItem("foodName", food);
        if (!response.ok || !result.success) {
            throw new Error(
                result.error || result.message || "Unable to save donation."
            );
        }

        sessionStorage.setItem("foodName", foodName);
        sessionStorage.setItem("quantity", String(quantity));
        sessionStorage.setItem("unit", unit);
        sessionStorage.setItem("pickupLocation", location);
        sessionStorage.setItem("pickupLocation", pickupAddress);
        sessionStorage.setItem("foodId", String(result.foodId));

        window.location.href = "/matching";

    } catch (error) {
        alert(error.message || "Unable to save donation. Please try again.");
        button.disabled = false;
        button.textContent = "Find Nearby NGO";
        console.error("Donation submission failed:", error);
        formMessage.textContent = error.message;
        submitButton.disabled = false;
        submitButton.textContent = "Find Nearby NGO";
    }
});
</script>


