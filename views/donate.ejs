
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donate Food | Food Harvest AI</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">🍱 Food Harvest <span>AI</span></div>
    <div class="nav-links"><a href="/">Home</a></div>
</nav>

<main class="hero">
    <section class="hero-content">
        <div class="badge">Food Redistribution</div>
        <h1>Donate Surplus <span>Food.</span></h1>
        <p class="hero-description">
            Share available food with an NGO in your area.
        </p>
    </section>

    <form id="donationForm" class="stat-card"
          style="max-width:550px;margin:35px auto;text-align:left">

        <label for="foodName">Food name</label>
        <input id="foodName" required placeholder="e.g. Vegetable Biryani"
               style="width:100%;padding:12px;margin:8px 0 18px">

        <label for="quantity">Quantity</label>
        <input id="quantity" type="number" min="0.1" step="any"
               required placeholder="e.g. 25"
               style="width:100%;padding:12px;margin:8px 0 18px">

        <label for="unit">Unit</label>
        <select id="unit"
                style="width:100%;padding:12px;margin:8px 0 18px">
            <option value="kg">Kilograms</option>
            <option value="meals">Meals</option>
            <option value="packets">Packets</option>
        </select>

        <label for="location">Pickup location</label>
        <input id="location" required placeholder="e.g. Ahmedabad"
               style="width:100%;padding:12px;margin:8px 0 22px">

        <button type="submit" class="btn btn-primary"
                style="width:100%;border:0;cursor:pointer">
            Find Nearby NGO
        </button>
    </form>
</main>

<script>
document.getElementById("donationForm").addEventListener("submit", function(e) {
    e.preventDefault();

    const food = document.getElementById("foodName").value.trim();
    const quantity = Number(document.getElementById("quantity").value);
    const unit = document.getElementById("unit").value;
    const location = document.getElementById("location").value.trim();

    if (!food || !location || !Number.isFinite(quantity) || quantity <= 0) {
        alert("Please enter valid food details.");
        return;
    }

    sessionStorage.setItem("foodName", food);
    sessionStorage.setItem("quantity", String(quantity));
    sessionStorage.setItem("unit", unit);
    sessionStorage.setItem("pickupLocation", location);

    window.location.href = "/matching";
});
</script>

</body>
</html>
