```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donate Food | Food Harvest AI</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">🍱 Food Harvest <span>AI</span></div>
    <div class="nav-links">
        <a href="/">Home</a>
    </div>
</nav>

<main class="hero">
    <section class="hero-content">
        <div class="badge">Food Redistribution</div>
        <h1>Donate Surplus <span>Food.</span></h1>
        <p class="hero-description">
            Share available food with an NGO in your area.
        </p>
    </section>

    <form id="donationForm" class="stat-card"
          style="max-width:550px;margin:35px auto;text-align:left">

        <label for="foodName">Food name</label>
        <input
            id="foodName"
            type="text"
            required
            maxlength="150"
            placeholder="e.g. Vegetable Biryani"
            style="width:100%;padding:12px;margin:8px 0 18px"
        >

        <label for="category">Food category</label>
        <select
            id="category"
            required
            style="width:100%;padding:12px;margin:8px 0 18px"
        >
            <option value="Rice">Rice</option>
            <option value="Curry">Curry</option>
            <option value="Vegetarian">Vegetarian</option>
            <option value="Gujarati">Gujarati</option>
            <option value="South Indian">South Indian</option>
            <option value="Other">Other</option>
        </select>

        <label for="quantity">Quantity</label>
        <input
            id="quantity"
            type="number"
            min="0.1"
            step="0.1"
            required
            placeholder="e.g. 25"
            style="width:100%;padding:12px;margin:8px 0 18px"
        >

        <label for="unit">Unit</label>
        <select
            id="unit"
            required
            style="width:100%;padding:12px;margin:8px 0 18px"
        >
            <option value="kg">Kilograms</option>
            <option value="plates">Plates</option>
            <option value="meals">Meals</option>
            <option value="packets">Packets</option>
        </select>

        <label for="location">Pickup location</label>
        <input
            id="location"
            type="text"
            required
            maxlength="255"
            placeholder="e.g. Navrangpura, Ahmedabad"
            style="width:100%;padding:12px;margin:8px 0 22px"
        >

        <p id="formMessage" role="status"
           style="margin:0 0 15px;color:#b02a37"></p>

        <button
            type="submit"
            class="btn btn-primary"
            style="width:100%;border:0;cursor:pointer"
        >
            Find Nearby NGO
        </button>
    </form>
</main>

<script>
const donationForm = document.getElementById("donationForm");
const formMessage = document.getElementById("formMessage");
const submitButton = donationForm.querySelector('button[type="submit"]');

donationForm.addEventListener("submit", async function(event) {
    event.preventDefault();

    formMessage.textContent = "";

    const foodName = document.getElementById("foodName").value.trim();
    const category = document.getElementById("category").value;
    const quantity = Number(document.getElementById("quantity").value);
    const unit = document.getElementById("unit").value;
    const pickupAddress = document.getElementById("location").value.trim();

    if (
        !foodName ||
        !category ||
        !unit ||
        !pickupAddress ||
        !Number.isFinite(quantity) ||
        quantity <= 0
    ) {
        formMessage.textContent = "Please enter valid donation details.";
        return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Saving donation...";

    try {
        const response = await fetch("/api/donations", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            body: JSON.stringify({
                food_name: foodName,
                category: category,
                quantity: quantity,
                unit: unit,
                pickup_address: pickupAddress
            })
        });

        const responseText = await response.text();
        let result;

        try {
            result = JSON.parse(responseText);
        } catch {
            console.error("Unexpected server response:", responseText);
            throw new Error(
                "The server did not return JSON. Check the Render logs and API route."
            );
        }

        if (!response.ok || !result.success) {
            throw new Error(
                result.error || result.message || "Unable to save donation."
            );
        }

        sessionStorage.setItem("foodName", foodName);
        sessionStorage.setItem("quantity", String(quantity));
        sessionStorage.setItem("unit", unit);
        sessionStorage.setItem("pickupLocation", pickupAddress);
        sessionStorage.setItem("foodId", String(result.foodId));

        window.location.href = "/matching";

    } catch (error) {
        console.error("Donation submission failed:", error);
        formMessage.textContent = error.message;
        submitButton.disabled = false;
        submitButton.textContent = "Find Nearby NGO";
    }
});
</script>

</body>
</html>
```
