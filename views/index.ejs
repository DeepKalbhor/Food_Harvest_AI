            </p>

            <a href="/dashboard" class="module-link">
                Open Dashboard <span>→</span>
            </a>

        </div>


    </div>

</section>


<!-- WORKFLOW -->

<section class="section" id="workflow">

    <div class="section-heading">

        <small>SIMPLE PROCESS</small>

        <h2>How Food Harvest AI Works.</h2>

        <p>
            A simple process connecting surplus food with communities.
        </p>

    </div>


    <div class="workflow">

        <div class="workflow-grid">


            <div class="step">

                <div class="step-number">01</div>

                <h3>Donate</h3>

                <p>
                    Restaurants submit available surplus
                    food through the platform.
                </p>

            </div>


            <div class="step">

                <div class="step-number">02</div>

                <h3>Match</h3>

                <p>
                    Suitable NGOs are identified based on
                    donation and location information.
                </p>

            </div>


            <div class="step">

                <div class="step-number">03</div>

                <h3>Coordinate</h3>

                <p>
                    Orders and delivery details are
                    shared with the relevant participants.
                </p>

            </div>


            <div class="step">

                <div class="step-number">04</div>

                <h3>Deliver</h3>

                <p>
                    Food reaches the selected NGO,
                    and the delivery status is updated.
                </p>

            </div>


        </div>

    </div>

</section>


