<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Food Harvest AI | Smarter Food Redistribution</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap');

        :root {
            --green: #176b45;
            --green-dark: #104d33;
            --green-light: #eaf4ed;
            --background: #fafbf9;
            --text: #192a20;
            --muted: #718077;
            --border: #e7ece7;
            --white: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--background);
            color: var(--text);
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        /* NAVBAR */

        .navbar {
            height: 78px;
            padding: 0 7%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.94);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background: var(--green);
            color: white;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 23px;
        }

        .logo-text {
            font-family: 'Manrope', sans-serif;
            font-weight: 800;
            font-size: 19px;
            letter-spacing: -0.7px;
        }

        .logo-text span {
            color: var(--green);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .nav-links a {
            font-size: 13px;
            font-weight: 600;
            color: #59665e;
            transition: .2s;
        }

        .nav-links a:hover {
            color: var(--green);
        }

        .nav-button {
            background: var(--green);
            color: white !important;
            padding: 12px 20px;
            border-radius: 7px;
        }

        .nav-button:hover {
            background: var(--green-dark);
        }

        /* HERO */

        .hero {
            padding: 90px 7% 85px;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            gap: 55px;
            align-items: center;
            max-width: 1500px;
            margin: auto;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 13px;
            border-radius: 30px;
            background: var(--green-light);
            color: var(--green);
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 25px;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #35a66a;
        }

        .hero h1 {
            font-family: 'Manrope', sans-serif;
            font-size: clamp(42px, 5.2vw, 69px);
            line-height: 1.12;
            letter-spacing: -3px;
            font-weight: 800;
            max-width: 650px;
        }

        .hero h1 span {
            color: var(--green);
        }

        .hero-description {
            color: var(--muted);
            font-size: 16px;
            line-height: 1.9;
            margin-top: 23px;
            max-width: 520px;
        }

        .hero-actions {
            display: flex;
            gap: 13px;
            margin-top: 34px;
            flex-wrap: wrap;
        }

        .primary-btn,
        .secondary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 15px 23px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            transition: .25s;
        }

        .primary-btn {
            background: var(--green);
            color: white;
        }

        .primary-btn:hover {
            background: var(--green-dark);
            transform: translateY(-2px);
        }

        .secondary-btn {
            background: white;
            border: 1px solid var(--border);
        }

        .secondary-btn:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .hero-note {
            display: flex;
            align-items: center;
            gap: 9px;
            color: var(--muted);
            font-size: 12px;
            margin-top: 30px;
        }

        /* HERO VISUAL */

        .hero-visual {
            position: relative;
            min-height: 410px;
            background: #eaf3e9;
            border-radius: 22px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .hero-visual::before {
            content: "";
            position: absolute;
            width: 330px;
            height: 330px;
            border-radius: 50%;
            background: #d2e7d3;
            top: -110px;
            right: -80px;
        }

        .hero-visual::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: #d6e9d8;
            bottom: -100px;
            left: -50px;
        }

        .visual-card {
            background: white;
            border: 1px solid rgba(0,0,0,.04);
            border-radius: 17px;
            padding: 25px;
            width: 100%;
            max-width: 370px;
            position: relative;
            z-index: 2;
            box-shadow: 0 20px 50px rgba(31,75,45,.10);
        }

        .visual-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .visual-title {
            font-size: 14px;
            font-weight: 800;
        }

        .live-label {
            font-size: 10px;
            color: var(--green);
            background: var(--green-light);
            padding: 6px 10px;
            border-radius: 20px;
            font-weight: 700;
        }

        .flow-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
        }

        .flow-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: var(--green-light);
            display: grid;
            place-items: center;
            font-size: 20px;
        }

        .flow-info strong {
            display: block;
            font-size: 13px;
        }

        .flow-info small {
            color: var(--muted);
            font-size: 11px;
        }

        .flow-arrow {
            color: #a5b5a9;
            margin-left: auto;
            font-size: 20px;
        }

        .flow-line {
            border-left: 1px dashed #cbd9cd;
            height: 17px;
            margin-left: 21px;
        }

        .visual-footer {
            margin-top: 20px;
            padding-top: 17px;
            border-top: 1px solid var(--border);
            color: var(--green);
            font-size: 12px;
            font-weight: 700;
        }

        /* SECTION COMMON */

        .section {
            padding: 75px 7%;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 43px;
        }

        .section-heading small {
            color: var(--green);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 800;
            font-size: 11px;
        }

        .section-heading h2 {
            font-family: 'Manrope', sans-serif;
            font-size: 35px;
            letter-spacing: -1.4px;
            margin-top: 12px;
        }

        .section-heading p {
            color: var(--muted);
            font-size: 14px;
            margin-top: 12px;
        }

        /* MODULES */

        .modules {
            background: white;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .module-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 17px;
            max-width: 1200px;
            margin: auto;
        }

        .module-card {
            padding: 26px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: white;
            transition: .25s;
        }

        .module-card:hover {
            border-color: #9cbea5;
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(30,70,40,.06);
        }

        .module-icon {
            width: 47px;
            height: 47px;
            display: grid;
            place-items: center;
            background: var(--green-light);
            border-radius: 12px;
            font-size: 22px;
            margin-bottom: 20px;
        }

        .module-card h3 {
            font-size: 16px;
            margin-bottom: 9px;
        }

        .module-card p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
            min-height: 44px;
        }

        .module-link {
            display: inline-block;
            color: var(--green);
            font-size: 12px;
            font-weight: 800;
            margin-top: 20px;
        }

        .module-link span {
            margin-left: 5px;
        }

        /* WORKFLOW */

        .workflow {
            max-width: 1200px;
            margin: auto;
        }

        .workflow-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .step {
            text-align: center;
            padding: 20px 12px;
        }

        .step-number {
            width: 45px;
            height: 45px;
            margin: auto auto 18px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--green);
            color: white;
            font-weight: 800;
        }

        .step h3 {
            font-size: 15px;
            margin-bottom: 9px;
        }

        .step p {
            font-size: 12px;
            line-height: 1.7;
            color: var(--muted);
        }

        /* CTA */

        .cta {
            padding: 0 7% 80px;
        }

        .cta-inner {
            max-width: 1200px;
            margin: auto;
            background: var(--green-dark);
            color: white;
            border-radius: 17px;
            padding: 55px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
        }

        .cta-inner h2 {
            font-family: 'Manrope', sans-serif;
            font-size: 30px;
            letter-spacing: -1px;
        }

        .cta-inner p {
            color: #d1e2d6;
            font-size: 13px;
            margin-top: 10px;
        }

        .cta-inner .primary-btn {
            background: white;
            color: var(--green-dark);
            white-space: nowrap;
        }

        /* FOOTER */

        footer {
            background: white;
            border-top: 1px solid var(--border);
            padding: 30px 7%;
        }

        .footer-content {
            max-width: 1200px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .footer-content p {
            color: var(--muted);
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-links a {
            font-size: 12px;
            color: #68766d;
        }

        /* CHATBOT */

        .chat-button {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 200;
            width: 60px;
            height: 60px;
            border: none;
            border-radius: 50%;
            background: var(--green);
            color: white;
            font-size: 25px;
            cursor: pointer;
            box-shadow: 0 6px 25px rgba(0,0,0,.2);
        }

        .chat-window {
            position: fixed;
            bottom: 100px;
            right: 25px;
            width: 350px;
            max-width: calc(100vw - 30px);
            height: 440px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 45px rgba(0,0,0,.17);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 200;
            border: 1px solid var(--border);
        }

        .chat-header {
            background: var(--green);
            color: white;
            padding: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-header strong {
            font-size: 14px;
        }

        .chat-header small {
            display: block;
            font-size: 10px;
            margin-top: 4px;
            opacity: .8;
        }

        .chat-close {
            border: none;
            color: white;
            background: transparent;
            font-size: 22px;
            cursor: pointer;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            background: #fafcf9;
        }

        .chat-message {
            font-size: 12px;
            line-height: 1.6;
            padding: 11px 13px;
            border-radius: 11px;
            margin-bottom: 10px;
            max-width: 88%;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .bot-message {
            background: #edf3ed;
            color: #26352b;
        }

        .user-message {
            background: var(--green);
            color: white;
            margin-left: auto;
        }

        .chat-input-area {
            display: flex;
            padding: 12px;
            gap: 8px;
            border-top: 1px solid var(--border);
        }

        .chat-input-area input {
            flex: 1;
            min-width: 0;
            padding: 12px;
            border: 1px solid var(--border);
            border-radius: 7px;
            outline: none;
            font-size: 12px;
        }

        .chat-input-area input:focus {
            border-color: var(--green);
        }

        .chat-input-area button {
            background: var(--green);
            color: white;
            border: none;
            border-radius: 7px;
            padding: 0 15px;
            cursor: pointer;
        }

        /* RESPONSIVE */

        @media(max-width: 900px) {

            .hero {
                grid-template-columns: 1fr;
                padding-top: 60px;
            }

            .hero-visual {
                min-height: 370px;
            }

            .module-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .workflow-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .nav-links {
                gap: 15px;
            }
        }

        @media(max-width: 600px) {

            .navbar {
                height: 68px;
                padding: 0 5%;
            }

            .nav-links {
                gap: 12px;
            }

            .nav-links a:not(.nav-button) {
                display: none;
            }

            .hero {
                padding: 55px 6%;
            }

            .hero h1 {
                letter-spacing: -2px;
            }

            .section {
                padding: 55px 6%;
            }

            .section-heading h2 {
                font-size: 27px;
            }

            .module-grid {
                grid-template-columns: 1fr;
            }

            .workflow-grid {
                grid-template-columns: 1fr 1fr;
            }

            .cta-inner {
                padding: 30px;
                flex-direction: column;
                align-items: flex-start;
            }

            .cta-inner h2 {
                font-size: 24px;
            }

            .footer-content {
                flex-direction: column;
                align-items: flex-start;
            }

        }

    </style>
</head>

<body>

<!-- NAVBAR -->

<nav class="navbar">

    <a href="/" class="logo">
