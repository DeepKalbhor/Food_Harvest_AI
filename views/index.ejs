```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Harvest AI</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f8faf8;
            color: #333;
        }

        nav {
            background: white;
            padding: 18px 8%;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
        }

        nav strong {
            color: #247747;
            font-size: 20px;
        }

        nav div {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
        }

        a {
            color: #247747;
            text-decoration: none;
        }

        nav a {
            color: #333;
        }

        nav a:hover {
            color: #247747;
        }

        main {
            max-width: 900px;
            margin: 70px auto;
            padding: 0 20px;
            text-align: center;
        }

        h1 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        main p {
            color: #666;
            line-height: 1.6;
        }

        .buttons {
            margin: 25px 0 55px;
        }

        .button {
            display: inline-block;
            margin: 5px;
            padding: 12px 18px;
            background: #247747;
            color: white;
            border-radius: 5px;
        }

        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 18px;
            text-align: left;
        }

        .card {
            background: white;
            padding: 22px;
            border: 1px solid #e2e8e2;
            border-radius: 7px;
        }

        .card h3 {
            margin-top: 0;
        }

        .card p {
            font-size: 14px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #777;
            border-top: 1px solid #ddd;
            background: white;
        }

        /* Chatbot */
        #chat-button {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 12px 17px;
            border: none;
            border-radius: 5px;
            background: #247747;
            color: white;
            cursor: pointer;
        }

        #chatbox {
            display: none;
            position: fixed;
            bottom: 75px;
            right: 20px;
            width: 300px;
            height: 380px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 7px;
            overflow: hidden;
        }

        #chat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: #247747;
            color: white;
        }

        #chat-header button {
            background: none;
            color: white;
            border: none;
            cursor: pointer;
        }

        #messages {
            height: 265px;
            overflow-y: auto;
            padding: 10px;
            font-size: 14px;
        }

        .message {
            margin-bottom: 10px;
            padding: 8px;
            border-radius: 5px;
            background: #f0f3f0;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
        }

        .user-message {
            background: #e1f2e5;
            text-align: right;
        }

        #chat-form {
            display: flex;
            padding: 8px;
            gap: 5px;
            border-top: 1px solid #ddd;
        }

        #chat-input {
            width: 100%;
            min-width: 0;
            padding: 8px;
            border: 1px solid #ddd;
        }

        #chat-form button {
            background: #247747;
            color: white;
            border: none;
            padding: 8px 12px;
            cursor: pointer;
        }

        @media (max-width: 600px) {
            nav {
                flex-direction: column;
            }

            main {
                margin-top: 40px;
            }

            h1 {
                font-size: 30px;
            }

            #chatbox {
                right: 10px;
                width: calc(100% - 20px);
                max-width: 300px;
            }
        }
    </style>
</head>

<body>

    <nav>
        <strong>Food Harvest AI</strong>

        <div>
            <a href="/">Home</a>
            <a href="/donate">Donate Food</a>
            <a href="/matching">NGO Matching</a>
            <a href="/orders">Orders</a>
            <a href="/dashboard">Dashboard</a>
        </div>
    </nav>

    <main>
        <h1>Reduce Food Waste, Share More Meals</h1>

        <p>
            Food Harvest AI connects restaurants with surplus food
            to NGOs that need it, helping communities access food
            while reducing waste.
        </p>

        <div class="buttons">
            <a class="button" href="/donate">Donate Food</a>
            <a class="button" href="/matching">Find an NGO</a>
        </div>

        <section class="features">
            <div class="card">
                <h3>Donate Food</h3>
                <p>Register surplus food and provide pickup details.</p>
                <a href="/donate">Create Donation →</a>
            </div>

            <div class="card">
                <h3>NGO Matching</h3>
                <p>Find suitable NGOs for available food donations.</p>
                <a href="/matching">Find NGOs →</a>
            </div>

            <div class="card">
                <h3>Manage Orders</h3>
                <p>Review orders and monitor their delivery status.</p>
                <a href="/orders">View Orders →</a>
            </div>
        </section>
    </main>

    <footer>
        Food Harvest AI © 2026
    </footer>

    <!-- Chatbot -->
    <button id="chat-button" type="button">Ask Food AI</button>

    <section id="chatbox">
        <div id="chat-header">
            <strong>Food Harvest AI Assistant</strong>
            <button id="close-chat" type="button">✕</button>
        </div>

        <div id="messages">
            <div class="message">
                Hello! Ask me about food donations, NGO matching, or orders.
            </div>
        </div>

        <form id="chat-form">
            <input
                id="chat-input"
                type="text"
                placeholder="Type a message..."
                maxlength="1000"
                autocomplete="off"
                required
            >
            <button type="submit">Send</button>
        </form>
    </section>

    <script>
        const chatbox = document.getElementById("chatbox");
        const messages = document.getElementById("messages");
        const chatInput = document.getElementById("chat-input");
        const chatForm = document.getElementById("chat-form");
        const sendButton = chatForm.querySelector("button");

        document.getElementById("chat-button").onclick = () => {
            chatbox.style.display = "block";
            chatInput.focus();
        };

        document.getElementById("close-chat").onclick = () => {
            chatbox.style.display = "none";
        };

        function addMessage(text, isUser = false) {
            const message = document.createElement("div");
            message.className = "message" +
                (isUser ? " user-message" : "");

            message.textContent = text;
            messages.appendChild(message);
            messages.scrollTop = messages.scrollHeight;

            return message;
        }

        chatForm.addEventListener("submit", async (event) => {
            event.preventDefault();

            const question = chatInput.value.trim();

            if (!question || sendButton.disabled) return;

            addMessage(question, true);
            chatInput.value = "";
            sendButton.disabled = true;

            const reply = addMessage("Thinking...");

            try {
                const response = await fetch("/api/ai-chat", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        message: question
                    })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(
                        data.message || "Unable to get a response."
                    );
                }

                reply.textContent =
                    data.reply || "No response received.";

            } catch (error) {
                reply.textContent =
                    error.message || "Could not connect to the AI assistant.";
            } finally {
                sendButton.disabled = false;
                chatInput.focus();
            }
        });
    </script>

</body>
</html>
```
