        </div>

    </div>


    <div class="hero-visual">

        <div class="visual-card">

            <div class="visual-top">

                <div class="visual-title">
                    Donation Workflow
                </div>

                <div class="live-label">
                    ● CONNECTED
                </div>

            </div>


            <div class="flow-item">

                <div class="flow-icon">🍲</div>

                <div class="flow-info">
                    <strong>Food Donation</strong>
                    <small>Restaurant registers surplus food</small>
