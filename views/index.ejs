```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Food Harvest AI</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f7f9f7;
            color: #243329;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 7%;
            background: white;
            border-bottom: 1px solid #e5ebe5;
        }

        .logo {
            font-size: 21px;
            font-weight: bold;
        }

        .logo span {
            color: #29965b;
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            align-items: center;
        }

        .nav-links a {
            color: #35473a;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: #29965b;
        }

        .hero {
            max-width: 1100px;
            margin: auto;
            padding: 75px 24px 45px;
            text-align: center;
        }

        .badge {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            background: #e5f6e9;
            color: #237a45;
            font-size: 13px;
            font-weight: bold;
        }

        h1 {
            margin: 22px 0 15px;
            font-size: clamp(34px, 5vw, 54px);
            line-height: 1.15;
        }

        h1 span {
            color: #29965b;
        }

        .hero-description {
            max-width: 620px;
            margin: 0 auto;
            color: #66736a;
            font-size: 17px;
            line-height: 1.7;
        }

        .actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 14px;
            margin-top: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            transition: 0.2s;
        }

        .btn-primary {
            background: #29965b;
            color: white;
        }

        .btn-primary:hover {
            background: #207a48;
        }

        .btn-secondary {
            background: white;
            color: #29965b;
            border: 1px solid #cfe5d5;
        }

        .btn-secondary:hover {
            background: #edf8f0;
        }

        .section {
            max-width: 1100px;
            margin: 0 auto;
            padding: 25px 24px 65px;
        }

        .section-heading {
            margin-bottom: 25px;
            text-align: center;
        }

        .section-heading h2 {
            margin-bottom: 8px;
            font-size: 27px;
        }

        .section-heading p {
            color: #718076;
            font-size: 14px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
        }

        .card {
            display: flex;
            flex-direction: column;
            padding: 25px;
            background: white;
            border: 1px solid #e5ebe5;
            border-radius: 13px;
            box-shadow: 0 4px 15px rgba(30, 60, 40, 0.04);
        }

        .card-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 48px;
            height: 48px;
            margin-bottom: 17px;
            border-radius: 10px;
            background: #e9f7ed;
            font-size: 24px;
        }

        .card h3 {
            margin: 0 0 10px;
            font-size: 19px;
        }

        .card p {
            flex-grow: 1;
            margin: 0 0 22px;
            color: #6b786e;
            font-size: 14px;
            line-height: 1.6;
        }

        .card .btn {
            text-align: center;
        }

        footer {
            padding: 22px;
            text-align: center;
            background: white;
            border-top: 1px solid #e5ebe5;
            color: #78847b;
            font-size: 13px;
        }

        @media (max-width: 750px) {
            .navbar {
                align-items: flex-start;
                gap: 16px;
                flex-direction: column;
                padding: 18px 5%;
            }

            .nav-links {
                gap: 15px;
            }

            .hero {
                padding-top: 50px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <nav class="navbar">
        <div class="logo">
            🍱 Food Harvest <span>AI</span>
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/donate">Donate Food</a>
            <a href="/matching">NGO Matching</a>
            <a href="/orders">Manage Orders</a>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <main>
        <section class="hero">
            <div class="badge">AI-Powered Food Redistribution</div>

            <h1>
                Reduce Food Waste.<br>
                <span>Share More Meals.</span>
            </h1>

            <p class="hero-description">
                Food Harvest AI connects surplus food donors with NGOs
                to help redistribute food efficiently and reduce waste.
            </p>

            <div class="actions">
                <a href="/donate" class="btn btn-primary">
                    Donate Surplus Food
                </a>

                <a href="/orders" class="btn btn-secondary">
                    Manage Orders
                </a>
            </div>
        </section>

        <!-- MAIN FEATURES -->
        <section class="section">
            <div class="section-heading">
                <h2>Manage Your Workflow</h2>
                <p>Access the main features of Food Harvest AI.</p>
            </div>

            <div class="cards">

                <!-- DONATE FOOD -->
                <article class="card">
                    <div class="card-icon">🍱</div>

                    <h3>Donate Food</h3>

                    <p>
                        Register surplus food, enter its quantity and
                        provide the pickup location to begin redistribution.
                    </p>

                    <a href="/donate" class="btn btn-primary">
                        Donate Food
                    </a>
                </article>

                <!-- NGO MATCHING -->
                <article class="card">
                    <div class="card-icon">🤝</div>

                    <h3>NGO Matching</h3>

                    <p>
                        View suitable NGOs for a food donation and create
                        an order with your selected NGO.
                    </p>

                    <a href="/matching" class="btn btn-secondary">
                        Find NGOs
                    </a>
                </article>

                <!-- ORDER MANAGEMENT -->
                <article class="card">
                    <div class="card-icon">📦</div>

                    <h3>Manage Orders</h3>

                    <p>
                        Enter an existing order ID, update its status
                        and check the latest order progress.
                    </p>

                    <a href="/orders" class="btn btn-primary">
                        Open Orders
                    </a>
                </article>

            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer>
        Food Harvest AI &copy; 2026 |
        Reducing food waste, one meal at a time.
    </footer>

</body>
</html>
```
