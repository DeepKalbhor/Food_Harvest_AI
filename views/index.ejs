```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Matching | Food Harvest AI</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        .ngo-list {
            max-width: 750px;
            margin: 30px auto;
            display: grid;
            gap: 16px;
            text-align: left;
        }

        .ngo-card {
            padding: 22px;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            background: #fff;
            color: #222;
        }

        .ngo-card h2 {
            margin: 0 0 10px;
            font-size: 21px;
        }

        .ngo-card p {
            margin: 7px 0;
        }

        .ngo-distance {
            color: #198754;
            font-weight: 600;
        }

        .match-number {
            display: inline-block;
            margin-bottom: 10px;
            padding: 5px 9px;
            background: #eef7f0;
            border-radius: 6px;
            font-size: 12px;
        }

        .ngo-note {
            color: #666;
            font-size: 13px;
        }
    </style>
</head>
<body>

<nav class="navbar">
    <div class="logo">🍱 Food Harvest <span>AI</span></div>
    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/donate">Donate Again</a>
    </div>
</nav>

<main class="hero">
    <section class="hero-content">
        <div class="badge">Food Redistribution</div>
        <h1>Find Your <span>NGO Match.</span></h1>
        <p class="hero-description">
            Compare verified NGOs near your pickup location.
        </p>
    </section>

    <section class="stat-card"
             style="max-width:750px;margin:25px auto;padding:25px">

        <h2>Your Donation</h2>
        <p id="foodDetails">Loading donation details...</p>
        <p id="statusMessage" role="status">
            Searching for verified NGOs...
        </p>
    </section>

    <section id="ngoList" class="ngo-list"></section>

    <p class="ngo-note" style="text-align:center">
        NGOs are ranked by distance. Listed capacity does not guarantee
        acceptance; please confirm availability with the NGO.
    </p>

    <div style="text-align:center;margin:30px">
        <a href="/donate" class="btn btn-primary"
           style="text-decoration:none">
            Donate More Food
        </a>

        <a href="/delivery/demo" class="track-btn"
           style="display:inline-block;margin:8px;text-decoration:none">
            📍 Open Demo Tracking
        </a>
    </div>
</main>

<script>
async function loadNGOMatches() {
    const status = document.getElementById("statusMessage");
    const list = document.getElementById("ngoList");
    const foodDetails = document.getElementById("foodDetails");
    const foodId = sessionStorage.getItem("foodId");

    if (!foodId) {
        status.textContent =
            "No saved donation found. Please submit the donation form first.";
        return;
    }

    try {
        const response = await fetch(
            "/api/matching-ngo?foodId=" + encodeURIComponent(foodId),
            { headers: { "Accept": "application/json" } }
        );

        const text = await response.text();
        let result;

        try {
            result = JSON.parse(text);
        } catch {
            throw new Error("Invalid server response. Check Render logs.");
        }

        if (!response.ok || !result.success) {
            throw new Error(result.error || "Unable to find NGOs.");
        }

        foodDetails.textContent =
            result.food.food_name + " — " +
            result.food.quantity + " " + result.food.unit;

        list.replaceChildren();

        if (!result.ngos || result.ngos.length === 0) {
            status.textContent =
                "No verified NGOs with available capacity were found.";
            return;
        }

        status.textContent =
            result.ngos.length + " verified NGO(s) found, ranked by distance.";

        result.ngos.forEach(function(ngo, index) {
            const card = document.createElement("article");
            card.className = "ngo-card";

            const rank = document.createElement("span");
            rank.className = "match-number";
            rank.textContent = index === 0
                ? "Nearest match"
                : "Match #" + (index + 1);

            const name = document.createElement("h2");
            name.textContent = ngo.ngo_name;

            const address = document.createElement("p");
            address.textContent = ngo.address || "Address not available";

            const distance = document.createElement("p");
            distance.className = "ngo-distance";
            distance.textContent =
                Number(ngo.distance_km).toFixed(1) + " km away";

            const capacity = document.createElement("p");
            capacity.textContent = "Listed capacity: " + ngo.capacity;

            card.append(rank, name, address, distance, capacity);
            list.appendChild(card);
        });

    } catch (error) {
        console.error("NGO matching failed:", error);
        status.textContent = error.message;
    }
}

loadNGOMatches();
</script>

</body>
</html>
```
