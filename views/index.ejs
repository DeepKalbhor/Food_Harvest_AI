<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Delivery Partner | Food Harvest AI</title>

<link
    rel="stylesheet"
    href="/css/style.css"
>

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
>
```

</head>

<body>

<div class="tracking-page">

```
<div class="tracking-header">


    <div class="tracking-title">

        <h2>
            🚚 Delivery Partner
        </h2>

        <p>
            Tracking room: <%= orderId %>
        </p>

    </div>


    <div class="status">

        <div
            id="statusDot"
            class="status-dot"
        ></div>

        <span id="statusText">
            Connecting...
        </span>

    </div>


</div>



<div class="map-wrapper">


    <div id="map"></div>


    <div class="map-card">

        <h3>
            📡 Live Location
        </h3>


        <div class="map-info">

            <span>
                Latitude
            </span>

            <span id="latitude">
                --
            </span>

        </div>


        <div class="map-info">

            <span>
                Longitude
            </span>

            <span id="longitude">
                --
            </span>

        </div>


        <div class="map-info">

            <span>
                GPS
            </span>

            <span id="gpsStatus">
                Waiting...
            </span>

        </div>

    </div>


</div>
```

</div>

<script src="/socket.io/socket.io.js"></script>

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

<script>


const socket = io();


const roomId = "<%= orderId %>";


/* =========================
   MAP
========================= */


const map = L.map("map")
    .setView(
        [23.0225, 72.5714],
        13
    );


L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
        attribution:
            "&copy; OpenStreetMap contributors"
    }
).addTo(map);


/* =========================
   DELIVERY MARKER
========================= */


let deliveryMarker = null;


/* Custom delivery icon */

const deliveryIcon = L.divIcon({

    className: "",

    html: `
        <div style="
            width:42px;
            height:42px;
            border-radius:50%;
            background:#269653;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:23px;
            border:3px solid white;
            box-shadow:0 3px 12px rgba(0,0,0,.25);
        ">
            🚚
        </div>
    `,

    iconSize: [42, 42],

    iconAnchor: [21, 21]

});


/* =========================
   SOCKET CONNECTION
========================= */


socket.on("connect", function() {

    console.log(
        "Connected:",
        socket.id
    );


    document
        .getElementById("statusDot")
        .classList
        .add("connected");


    document
        .getElementById("statusText")
        .innerText =
        "Connected";


    /* Join tracking room */

    socket.emit(
        "join-order",
        {

            orderId: roomId,

            role: "delivery"

        }
    );

});


/* =========================
   GPS
========================= */


if (
    navigator.geolocation
) {


    navigator.geolocation.watchPosition(

        function(position) {


            const latitude =
                position.coords.latitude;


            const longitude =
                position.coords.longitude;


            console.log(
                "GPS:",
                latitude,
                longitude
            );


            /* Update information */

            document
                .getElementById("latitude")
                .innerText =
                latitude.toFixed(6);


            document
                .getElementById("longitude")
                .innerText =
                longitude.toFixed(6);


            document
                .getElementById("gpsStatus")
                .innerText =
                "Active";


            /* Send to server */

            socket.emit(
                "send-location",
                {

                    latitude:
                        latitude,

                    longitude:
                        longitude

                }
            );


            /* Show own marker */

            if (!deliveryMarker) {


                deliveryMarker =
                    L.marker(
                        [
                            latitude,
                            longitude
                        ],
                        {
                            icon:
                                deliveryIcon
                        }
                    )
                    .addTo(map)
                    .bindPopup(
                        "🚚 You are here"
                    );


                deliveryMarker
                    .openPopup();


            } else {


                deliveryMarker
                    .setLatLng(
                        [
                            latitude,
                            longitude
                        ]
                    );

            }


            /* Zoom to delivery partner */

            map.setView(
                [
                    latitude,
                    longitude
                ],
                17
            );

        },


        function(error) {


            console.error(
                "GPS Error:",
                error.message
            );


            document
                .getElementById("gpsStatus")
                .innerText =
                "GPS unavailable";

        },


        {

            enableHighAccuracy: true,

            timeout: 10000,

            maximumAge: 0

        }

    );

}


</script>

</body>

</html>
