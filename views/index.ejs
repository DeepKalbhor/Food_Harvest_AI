                <div class="flow-arrow">✓</div>

            </div>

            <div class="flow-line"></div>


            <div class="flow-item">

                <div class="flow-icon">🤝</div>

                <div class="flow-info">
                    <strong>NGO Matching</strong>
                    <small>Suitable organisations identified</small>
                </div>

                <div class="flow-arrow">✓</div>

            </div>

            <div class="flow-line"></div>


            <div class="flow-item">

                <div class="flow-icon">🚚</div>

                <div class="flow-info">
                    <strong>Delivery Coordination</strong>
                    <small>Pickup and destination details</small>
                </div>

                <div class="flow-arrow">✓</div>

            </div>

            <div class="flow-line"></div>


            <div class="flow-item">

                <div class="flow-icon">🌱</div>

                <div class="flow-info">
                    <strong>Food Delivered</strong>
                    <small>Donation reaches its destination</small>
                </div>

                <div class="flow-arrow">✓</div>

            </div>


            <div class="visual-footer">
                One platform. One connected workflow.
            </div>

        </div>

    </div>

</section>


<!-- MODULES -->

<section class="section modules" id="modules">

    <div class="section-heading">

        <small>OUR PLATFORM</small>

        <h2>Everything in One Place.</h2>

        <p>
            Access all the essential tools for managing food redistribution.
        </p>

    </div>


    <div class="module-grid">


        <div class="module-card">

            <div class="module-icon">🍱</div>

            <h3>Food Donation</h3>

            <p>
                Register surplus food with quantity, category,
                availability and pickup information.
            </p>

            <a href="/donate" class="module-link">
                Donate Food <span>→</span>
            </a>

        </div>


        <div class="module-card">

            <div class="module-icon">🤝</div>

            <h3>NGO Matching</h3>

            <p>
                Find suitable NGOs using donation information,
                location and available capacity.
            </p>

            <a href="/matching" class="module-link">
                Find NGOs <span>→</span>
            </a>

        </div>


        <div class="module-card">

            <div class="module-icon">📦</div>

            <h3>Order Management</h3>

            <p>
                Manage donation orders and monitor their
                progress from creation to delivery.
            </p>

            <a href="/orders" class="module-link">
                Manage Orders <span>→</span>
            </a>

        </div>


        <div class="module-card">

            <div class="module-icon">🚚</div>

            <h3>Delivery Coordination</h3>

            <p>
                Access delivery information, pickup locations
                and NGO destination details.
            </p>

            <a href="/orders" class="module-link">
                View Orders <span>→</span>
            </a>

        </div>


        <div class="module-card">

            <div class="module-icon">📍</div>

            <h3>Live Tracking</h3>

            <p>
                Follow delivery progress using an order-specific
                tracking link.
            </p>

            <a href="/orders" class="module-link">
                Find an Order <span>→</span>
            </a>

        </div>


        <div class="module-card">

            <div class="module-icon">📊</div>

            <h3>Dashboard & Reports</h3>

            <p>
                Monitor donations, order statuses and
