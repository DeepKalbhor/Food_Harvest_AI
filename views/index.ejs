```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Harvest AI</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        :root {
            --green: #176b45;
            --light-green: #e8f5ec;
            --text: #26352b;
            --muted: #68766c;
            --border: #e2eae3;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            color: var(--text);
            background: #f6f9f6;
        }

        a {
            text-decoration: none;
        }

        /* Navigation */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 18px 6%;
            background: white;
            border-bottom: 1px solid var(--border);
        }

        .logo {
            font-size: 21px;
            font-weight: bold;
        }

        .logo span {
            color: var(--green);
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }

        .nav-links a {
            color: var(--text);
            font-size: 14px;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: var(--green);
        }

        /* Hero */
        .hero {
            max-width: 1050px;
            margin: auto;
            padding: 65px 24px 45px;
            text-align: center;
        }

        .badge {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 20px;
            background: var(--light-green);
            color: var(--green);
            font-size: 13px;
            font-weight: bold;
        }

        h1 {
            margin: 22px 0 15px;
            font-size: clamp(34px, 5vw, 52px);
            line-height: 1.15;
        }

        h1 span {
            color: var(--green);
        }

        .hero p {
            max-width: 620px;
            margin: auto;
            color: var(--muted);
            font-size: 16px;
            line-height: 1.7;
        }

        .actions {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 26px;
        }

        .btn {
            display: inline-block;
            padding: 12px 19px;
            border: 1px solid var(--green);
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            transition: 0.2s;
        }

        .btn-primary {
            color: white;
            background: var(--green);
        }

        .btn-primary:hover {
            background: #105437;
        }

        .btn-secondary {
            color: var(--green);
            background: white;
        }

        .btn-secondary:hover {
            background: var(--light-green);
        }

        /* Feature cards */
        .section {
            max-width: 1100px;
            margin: auto;
            padding: 20px 24px 60px;
        }

        .section-heading {
            margin-bottom: 25px;
            text-align: center;
        }

        .section-heading h2 {
            margin-bottom: 8px;
            font-size: 27px;
        }

        .section-heading p {
            color: var(--muted);
            font-size: 14px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .card {
            display: flex;
            flex-direction: column;
            padding: 23px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 13px;
            box-shadow: 0 4px 15px #1e3c2808;
        }

        .card-icon {
            display: grid;
            place-items: center;
            width: 45px;
            height: 45px;
            margin-bottom: 15px;
            border-radius: 10px;
            background: var(--light-green);
            font-size: 22px;
        }

        .card h3 {
            margin: 0 0 10px;
            font-size: 18px;
        }

        .card p {
            flex: 1;
            margin: 0 0 20px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .card .btn {
            text-align: center;
        }

        /* Footer */
        footer {
            padding: 22px;
            text-align: center;
            color: var(--muted);
            background: white;
            border-top: 1px solid var(--border);
            font-size: 13px;
        }

        /* AI chatbot */
        #ai-launch {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1000;
            padding: 13px 18px;
            border: 0;
            border-radius: 30px;
            color: white;
            background: var(--green);
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 5px 20px #0002;
        }

        #ai-panel {
            display: none;
            position: fixed;
            right: 22px;
            bottom: 80px;
            z-index: 1001;
            width: min(350px, calc(100vw - 28px));
            height: 440px;
            max-height: calc(100vh - 105px);
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 15px;
            background: white;
            box-shadow: 0 10px 35px #0002;
        }

        #ai-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            color: white;
            background: var(--green);
        }

        #ai-close {
            border: 0;
            color: white;
            background: transparent;
            font-size: 18px;
            cursor: pointer;
        }

        #ai-messages {
            height: calc(100% - 125px);
            overflow-y: auto;
            padding: 13px;
            background: #f7faf7;
        }

        .ai-message {
            max-width: 88%;
            margin-bottom: 10px;
            padding: 10px 12px;
            border-radius: 12px;
            font-size: 14px;
            line-height: 1.5;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .ai-bot {
            border: 1px solid var(--border);
            background: white;
        }

        .ai-user {
            margin-left: auto;
            background: #dff2e5;
        }

        #ai-form {
            display: flex;
            gap: 8px;
            padding: 10px;
            border-top: 1px solid var(--border);
        }

        #ai-input {
            flex: 1;
            min-width: 0;
            padding: 10px;
            border: 1px solid #d5ded5;
            border-radius: 8px;
        }

        #ai-form button {
            padding: 0 14px;
            border: 0;
            border-radius: 8px;
            color: white;
            background: var(--green);
            cursor: pointer;
        }

        @media (max-width: 760px) {
            .navbar {
                align-items: flex-start;
                flex-direction: column;
                padding: 17px 5%;
            }

            .nav-links {
                gap: 12px;
            }

            .hero {
                padding-top: 45px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="logo">🍱 Food Harvest <span>AI</span></div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/donate">Donate Food</a>
            <a href="/matching">NGO Matching</a>
            <a href="/orders">Manage Orders</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/delivery-partner">Delivery Partner</a>
        </div>
    </nav>

    <main>
        <section class="hero">
            <span class="badge">AI-Powered Food Redistribution</span>

            <h1>
                Reduce Food Waste.<br>
                <span>Share More Meals.</span>
            </h1>

            <p>
                Connect surplus food from restaurants with NGOs that need it.
                Manage donations, match recipients, and follow deliveries
                in one simple place.
            </p>

            <div class="actions">
                <a class="btn btn-primary" href="/donate">Donate Food</a>
                <a class="btn btn-secondary" href="/matching">Find an NGO</a>
            </div>
        </section>

        <section class="section">
            <div class="section-heading">
                <h2>Your Food Redistribution Workflow</h2>
                <p>Choose a feature to get started.</p>
            </div>

            <div class="cards">
                <article class="card">
                    <div class="card-icon">🍱</div>
                    <h3>Donate Food</h3>
                    <p>
                        Register surplus food, quantity, and pickup details
                        to start a donation.
                    </p>
                    <a class="btn btn-primary" href="/donate">
                        Create Donation
                    </a>
                </article>

                <article class="card">
                    <div class="card-icon">🤝</div>
                    <h3>Match with an NGO</h3>
                    <p>
                        Find suitable NGOs for a donation and create an order
                        with your chosen recipient.
                    </p>
                    <a class="btn btn-secondary" href="/matching">
                        Find NGOs
                    </a>
                </article>

                <article class="card">
                    <div class="card-icon">📦</div>
                    <h3>Manage Orders</h3>
                    <p>
                        View order details and update progress using an
                        existing order ID.
                    </p>
                    <a class="btn btn-primary" href="/orders">
                        Open Orders
                    </a>
                </article>
            </div>
        </section>
    </main>

    <footer>
        Food Harvest AI © 2026 · Reducing food waste, one meal at a time.
    </footer>

    <button id="ai-launch" type="button">✦ Ask Food AI</button>

    <section id="ai-panel" aria-label="Food Harvest AI Assistant">
        <header id="ai-head">
            <div>
                <strong>Food Harvest AI</strong><br>
                <small>Donation assistant</small>
            </div>
            <button id="ai-close" type="button" aria-label="Close chat">✕</button>
        </header>

        <div id="ai-messages" aria-live="polite">
            <div class="ai-message ai-bot">
                Hi! I can help with donations, NGO matching, orders,
                and delivery tracking. What would you like to know?
            </div>
        </div>

        <form id="ai-form">
            <input id="ai-input" maxlength="1000"
                   placeholder="Ask a question..." autocomplete="off" required>
            <button type="submit">Send</button>
        </form>
    </section>

    <script>
        const panel = document.getElementById("ai-panel");
        const messages = document.getElementById("ai-messages");
        const input = document.getElementById("ai-input");
        const form = document.getElementById("ai-form");
        const sendButton = form.querySelector("button");

        document.getElementById("ai-launch").addEventListener("click", () => {
            panel.style.display = "block";
            input.focus();
        });

        document.getElementById("ai-close").addEventListener("click", () => {
            panel.style.display = "none";
        });

        function addMessage(text, type) {
            const bubble = document.createElement("div");
            bubble.className = "ai-message " + type;
            bubble.textContent = text;
            messages.appendChild(bubble);
            messages.scrollTop = messages.scrollHeight;
            return bubble;
        }

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const question = input.value.trim();
            if (!question || sendButton.disabled) return;

            addMessage(question, "ai-user");
            input.value = "";
            sendButton.disabled = true;

            const replyBubble = addMessage("Thinking...", "ai-bot");

            try {
                const response = await fetch("/api/ai-chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ message: question })
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || "Request failed");
                }

                replyBubble.textContent =
                    data.reply || "I couldn't generate a response.";

            } catch (error) {
                replyBubble.textContent =
                    error.message || "Could not connect to the assistant.";
            } finally {
                sendButton.disabled = false;
                input.focus();
            }
        });
    </script>

</body>
</html>
```
