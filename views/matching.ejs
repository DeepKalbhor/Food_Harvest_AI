```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Matching | Food Harvest AI</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 28px 16px;
            font-family: Arial, sans-serif;
            background: #f5f7f4;
            color: #26332b;
        }

        .container {
            max-width: 950px;
            margin: auto;
        }

        h1 {
            margin-bottom: 8px;
            font-size: 28px;
        }

        .subtitle {
            color: #69756d;
            margin-bottom: 24px;
        }

        #message {
            display: none;
            padding: 14px;
            margin-bottom: 18px;
            border-radius: 8px;
            background: #e8f5e9;
            color: #216b35;
            overflow-wrap: anywhere;
        }

        #message.error {
            background: #ffebee;
            color: #b42318;
        }

        #ngoList {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
        }

        .ngo-card {
            background: white;
            border: 1px solid #e0e7e1;
            border-radius: 12px;
            padding: 20px;
        }

        .ngo-card h2 {
            font-size: 19px;
            margin: 0 0 12px;
        }

        .detail {
            color: #68746b;
            font-size: 14px;
            margin: 8px 0;
        }

        .distance {
            font-weight: bold;
            color: #277443;
        }

        button {
            width: 100%;
            border: 0;
            border-radius: 8px;
            padding: 12px;
            margin-top: 14px;
            background: #278447;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #1d6837;
        }

        button:disabled {
            background: #9ba69e;
            cursor: not-allowed;
        }

        .empty {
            background: white;
            padding: 20px;
            border-radius: 10px;
            color: #68746b;
        }

        .action-links {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 12px;
        }

        .action-links a {
            color: #216b35;
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        .action-links .whatsapp {
            color: #168447;
        }
    </style>
</head>

<body>
    <main class="container">
        <h1>Find a Matching NGO</h1>

        <p class="subtitle">
            Choose an eligible NGO to create a donation order and enable tracking.
        </p>

        <div id="message" role="status" aria-live="polite"></div>

        <div id="ngoList">
            <p>Finding eligible NGOs...</p>
        </div>
    </main>

    <script>
        const ngoList = document.getElementById("ngoList");
        const message = document.getElementById("message");

        const foodId = Number(sessionStorage.getItem("foodId"));

        let orderCreated = false;
        let loadingNGOs = false;

        function showMessage(text, isError = false) {
            message.style.display = "block";
            message.className = isError ? "error" : "";
            message.textContent = text;
        }

        function addTextElement(parent, tag, className, text) {
            const element = document.createElement(tag);

            if (className) {
                element.className = className;
            }

            element.textContent = text;
            parent.appendChild(element);

            return element;
        }

        async function fetchJSON(url, options = {}) {
            const response = await fetch(url, {
                credentials: "same-origin",
                ...options
            });

            let result;

            try {
                result = await response.json();
            } catch {
                throw new Error(
                    "Invalid server response. Please check the server logs."
                );
            }

            if (!response.ok) {
                throw new Error(
                    result.message || "Request failed: " + response.status
                );
            }

            return result;
        }

        async function loadNGOs() {
            if (loadingNGOs) return;
            loadingNGOs = true;

            ngoList.innerHTML = "";
            message.style.display = "none";

            try {
                if (!Number.isInteger(foodId) || foodId <= 0) {
                    throw new Error(
                        "Donation ID not found. Please submit your donation again."
                    );
                }

                addTextElement(
                    ngoList,
                    "p",
                    "",
                    "Finding eligible NGOs..."
                );

                const result = await fetchJSON(
                    "/api/matching-ngo?foodId=" +
                    encodeURIComponent(foodId)
                );

                const ngos = Array.isArray(result.ngos)
                    ? result.ngos
                    : [];

                ngoList.innerHTML = "";

                if (ngos.length === 0) {
                    addTextElement(
                        ngoList,
                        "p",
                        "empty",
                        "No eligible NGOs were found for this donation."
                    );
                    return;
                }

                ngos.forEach(function(ngo) {
                    const card = document.createElement("article");
                    card.className = "ngo-card";

                    addTextElement(
                        card,
                        "h2",
                        "",
                        ngo.name ||
                        ngo.ngo_name ||
                        ("NGO #" + ngo.ngo_id)
                    );

                    if (ngo.address) {
                        addTextElement(
                            card,
                            "p",
                            "detail",
                            ngo.address
                        );
                    }

                    if (
                        ngo.distance_km !== undefined &&
                        ngo.distance_km !== null &&
                        Number.isFinite(Number(ngo.distance_km))
                    ) {
                        addTextElement(
                            card,
                            "p",
                            "detail distance",
                            "Distance: " +
                            Number(ngo.distance_km).toFixed(2) +
                            " km"
                        );
                    }

                    if (
                        ngo.capacity !== undefined &&
                        ngo.capacity !== null
                    ) {
                        addTextElement(
                            card,
                            "p",
                            "detail",
                            "Available capacity: " + ngo.capacity
                        );
                    }

                    const button = document.createElement("button");
                    button.type = "button";
                    button.textContent = "Select NGO & Create Order";

                    button.addEventListener("click", function() {
                        createOrder(ngo.ngo_id, button);
                    });

                    card.appendChild(button);
                    ngoList.appendChild(card);
                });

            } catch (error) {
                ngoList.innerHTML = "";

                addTextElement(
                    ngoList,
                    "p",
                    "empty",
                    "Unable to load matching NGOs."
                );

                showMessage(
                    error.message || "Unable to load matching NGOs.",
                    true
                );

                console.error("NGO matching error:", error);

            } finally {
                loadingNGOs = false;
            }
        }

        async function createOrder(ngoId, clickedButton) {
            if (orderCreated) return;

            if (!ngoId) {
                showMessage("This NGO has no valid ID.", true);
                return;
            }

            const buttons = ngoList.querySelectorAll("button");

            buttons.forEach(function(button) {
                button.disabled = true;
            });

            clickedButton.textContent = "Creating order...";

            try {
                const result = await fetchJSON("/api/create-order", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        foodId: foodId,
                        ngoId: Number(ngoId)
                    })
                });

                if (!result.success || !result.orderId) {
                    throw new Error(
                        result.message || "Order creation failed."
                    );
                }

                orderCreated = true;

                showMessage(
                    "Order created successfully! Order ID: " +
                    result.orderId
                );

                buttons.forEach(function(button) {
                    button.textContent = "Order Created";
                });

                // Use one order ID for all three links.
                const orderId = result.orderId;

                const links = document.createElement("div");
                links.className = "action-links";

                // Live tracking link.
                const trackingLink = document.createElement("a");
                trackingLink.href =
                    "/track/" + encodeURIComponent(orderId);
                trackingLink.textContent = "Open Live Tracking";

                // Delivery partner page.
                const deliveryLink = document.createElement("a");
                deliveryLink.href =
                    "/delivery/" + encodeURIComponent(orderId);
                deliveryLink.textContent =
                    "Open Delivery Partner Page";

                // WhatsApp notification with prefilled message.
                const deliveryUrl =
                    window.location.origin +
                    "/delivery/" + encodeURIComponent(orderId);

                const messageText =
                    "New Food Harvest AI delivery order!\n\n" +
                    "Order ID: " + orderId + "\n" +
                    "Delivery page: " + deliveryUrl + "\n\n" +
                    "Please open the delivery page and allow location access.";

                const whatsappLink = document.createElement("a");
                whatsappLink.className = "whatsapp";
                whatsappLink.href =
                    "https://wa.me/?text=" +
                    encodeURIComponent(messageText);

                whatsappLink.target = "_blank";
                whatsappLink.rel = "noopener noreferrer";
                whatsappLink.textContent =
                    "Notify Delivery Partner on WhatsApp";

                links.appendChild(trackingLink);
                links.appendChild(deliveryLink);
                links.appendChild(whatsappLink);

                message.appendChild(links);

                console.log("Order ID:", orderId);
                console.log("Tracking URL:", trackingLink.href);
                console.log("Delivery URL:", deliveryLink.href);

            } catch (error) {
                showMessage(
                    error.message || "Unable to create order.",
                    true
                );

                buttons.forEach(function(button) {
                    button.disabled = false;
                });

                clickedButton.textContent =
                    "Select NGO & Create Order";

                console.error("Create order error:", error);
            }
        }

        loadNGOs();
    </script>
</body>
</html>
```
