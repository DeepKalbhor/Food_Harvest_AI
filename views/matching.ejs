<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Matching | Food Harvest AI</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">🍱 Food Harvest <span>AI</span></div>
    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/donate">Donate Again</a>
    </div>
</nav>

<main class="hero">
    <section class="hero-content">
        <div class="badge">Food Redistribution</div>
        <h1>Finding Your <span>NGO Match.</span></h1>
        <p class="hero-description">
            We are checking verified NGOs near your pickup location.
        </p>
    </section>

    <section class="stat-card"
             style="max-width:550px;margin:35px auto;text-align:left;padding:28px">

        <p id="statusMessage" role="status">
            Searching for the nearest verified NGO...
        </p>

        <div id="matchDetails" hidden>
            <hr style="margin:20px 0">

            <h2 id="foodTitle"></h2>
            <p id="foodQuantity"></p>

            <hr style="margin:20px 0">

            <p style="color:#198754;font-weight:600">
                Recommended NGO
            </p>

            <h2 id="ngoName"></h2>
            <p id="ngoAddress"></p>
            <p id="ngoDistance"></p>
            <p id="ngoCapacity"></p>

            <p style="font-size:13px;color:#666">
                Recommendation based on distance and NGO verification.
                Availability should be confirmed with the NGO.
            </p>
        </div>

        <div style="margin-top:25px">
            <a href="/donate" class="btn btn-primary"
               style="display:inline-block;text-decoration:none">
                Donate More Food
            </a>

            <a href="/delivery/demo" class="track-btn"
               style="display:inline-block;margin:8px;text-decoration:none">
                📍 Open Demo Tracking
            </a>
        </div>
    </section>
</main>

<script>
async function findNGOMatch() {
    const statusMessage = document.getElementById("statusMessage");
    const matchDetails = document.getElementById("matchDetails");

    const foodId = sessionStorage.getItem("foodId");

    if (!foodId) {
        statusMessage.textContent =
            "No saved donation was found. Please submit the donation form first.";
        return;
    }

    try {
        const response = await fetch(
            "/api/matching-ngo?foodId=" + encodeURIComponent(foodId),
            {
                headers: { "Accept": "application/json" }
            }
        );

        const text = await response.text();
        let result;

        try {
            result = JSON.parse(text);
        } catch {
            throw new Error("The server returned an invalid response.");
        }

        if (!response.ok || !result.success) {
            throw new Error(
                result.error || "No matching NGO was found."
            );
        }

        document.getElementById("foodTitle").textContent =
            result.food.food_name;

        document.getElementById("foodQuantity").textContent =
            "Quantity: " + result.food.quantity + " " + result.food.unit;

        document.getElementById("ngoName").textContent =
            result.ngo.ngo_name;

        document.getElementById("ngoAddress").textContent =
            result.ngo.address || "Address not available";

        document.getElementById("ngoDistance").textContent =
            "Distance: " + result.ngo.distance_km.toFixed(1) + " km";

        document.getElementById("ngoCapacity").textContent =
            "Listed capacity: " + result.ngo.capacity;

        matchDetails.hidden = false;
        statusMessage.textContent = "Your nearest verified NGO match is ready.";

    } catch (error) {
        console.error("NGO matching failed:", error);
        statusMessage.textContent = error.message;
    }
}

findNGOMatch();
</script>

</body>
</html>
