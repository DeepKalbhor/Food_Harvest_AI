
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Matching | Food Harvest AI</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar">
    <div class="logo">🍱 Food Harvest <span>AI</span></div>
    <div class="nav-links"><a href="/">Home</a></div>
</nav>

<main class="hero">
    <section class="hero-content">
        <div class="badge">NGO Matching</div>
        <h1>Your Food, <span>Matched.</span></h1>
        <p class="hero-description">
            Review the donation details and suggested NGO.
        </p>
    </section>

    <section class="stat-card" style="max-width:550px;margin:35px auto;text-align:left">
        <h2 id="foodDisplay">Your donation</h2>
        <p id="locationDisplay" style="margin:12px 0;color:#68776e"></p>

        <hr style="border:0;border-top:1px solid #e3ebe5;margin:20px 0">

        <div class="badge">Suggested NGO · Demo result</div>
        <h2>🤝 Helping Hands Ahmedabad</h2>
        <p style="margin-top:12px;color:#68776e;line-height:1.7">
            Suggested match for your donation. A real matching result
            requires checking NGO location, capacity and food requirements.
        </p>

        <div class="buttons" style="flex-wrap:wrap">
            <button id="trackButton" class="btn btn-primary"
                    style="border:0;cursor:pointer">
                Start Live Tracking
            </button>
            <a href="/donate" class="btn btn-secondary">Back</a>
        </div>
    </section>
</main>

<script>
const food = sessionStorage.getItem("foodName");
const quantity = sessionStorage.getItem("quantity");
const unit = sessionStorage.getItem("unit");
const location = sessionStorage.getItem("pickupLocation");

if (!food || !quantity || !unit || !location) {
    document.getElementById("foodDisplay").textContent =
        "No donation details found";

    document.getElementById("locationDisplay").textContent =
        "Please return to the donation form and enter your details.";

    document.getElementById("trackButton").disabled = true;
} else {
    document.getElementById("foodDisplay").textContent =
        `${food} — ${quantity} ${unit}`;

    document.getElementById("locationDisplay").textContent =
        `Pickup location: ${location}`;
}

document.getElementById("trackButton").addEventListener("click", function() {
    window.location.href = "/delivery/demo";
});
</script>

</body>
</html>
