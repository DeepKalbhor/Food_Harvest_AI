<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Track Delivery | Food Harvest AI</title>

    <link rel="stylesheet"
          href="/css/style.css">

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

</head>

<body>

<div class="tracking-page">

    <div class="tracking-header">

        <div class="tracking-title">

            <h2>
                📍 Live Delivery Tracking
            </h2>

            <p>
                Food Harvest AI
            </p>

        </div>

        <div class="status">

            <div id="statusDot"
                 class="status-dot">
            </div>

            <span id="statusText">
                Connecting...
            </span>

        </div>

    </div>


    <div class="map-wrapper">

        <div id="map"></div>


        <div class="map-card">

            <h3>
                🚚 Delivery Partner
            </h3>

            <div class="map-info">

                <span>Status</span>

                <span id="deliveryStatus">
                    Waiting...
                </span>

            </div>

            <div class="map-info">

                <span>Latitude</span>

                <span id="latitude">
                    --
                </span>

            </div>

            <div class="map-info">

                <span>Longitude</span>

                <span id="longitude">
                    --
                </span>

            </div>

        </div>

    </div>

</div>


<script src="/socket.io/socket.io.js"></script>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>


<script>

const socket = io();

const roomId = "<%= orderId %>";

console.log("Tracking room:", roomId);


/* =========================
   MAP
========================= */

const map = L.map("map");

L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
        maxZoom: 19,
        attribution:
            "&copy; OpenStreetMap contributors"
    }
).addTo(map);


/*
   Start with a normal view.
   We will automatically move to
   the delivery location when received.
*/

map.setView(
    [23.0225, 72.5714],
    13
);


/* =========================
   MARKERS
========================= */

let deliveryMarker = null;


/* Delivery icon */

const deliveryIcon = L.divIcon({

    className: "delivery-marker",

    html: "🚚",

    iconSize: [40, 40],

    iconAnchor: [20, 20]

});


/* NGO location */

const ngoLatitude = 23.1600;
const ngoLongitude = 72.6750;


/* NGO marker */

const ngoMarker = L.marker(
    [
        ngoLatitude,
        ngoLongitude
    ]
)
.addTo(map)
.bindPopup("📍 NGO");


/* =========================
   SOCKET CONNECTION
========================= */

socket.on("connect", function () {

    console.log(
        "Socket connected:",
        socket.id
    );

    document
        .getElementById("statusDot")
        .classList
        .add("connected");

    document
        .getElementById("statusText")
        .innerText = "Live";


    /*
       IMPORTANT:
       Join the SAME room as delivery tab.
    */

    socket.emit(
        "join-order",
        {
            orderId: roomId,
            role: "client"
        }
    );

});


/* =========================
   RECEIVE LOCATION
========================= */

socket.on(
    "receive-location",
    function (data) {

        console.log(
            "LOCATION RECEIVED:",
            data
        );


        const latitude =
            Number(data.latitude);

        const longitude =
            Number(data.longitude);


        if (
            !Number.isFinite(latitude) ||
            !Number.isFinite(longitude)
        ) {

            console.error(
                "Invalid coordinates"
            );

            return;
        }


        /*
           Update information card
        */

        document
            .getElementById("latitude")
            .innerText =
            latitude.toFixed(6);

        document
            .getElementById("longitude")
            .innerText =
            longitude.toFixed(6);

        document
            .getElementById("deliveryStatus")
            .innerText =
            "Live location received";


        /*
           CREATE MARKER
        */

        if (!deliveryMarker) {

            deliveryMarker =
                L.marker(
                    [
                        latitude,
                        longitude
                    ],
                    {
                        icon:
                            deliveryIcon
                    }
                )
                .addTo(map)
                .bindPopup(
                    "🚚 Delivery Partner"
                );

        }

        else {

            deliveryMarker.setLatLng(
                [
                    latitude,
                    longitude
                ]
            );

        }


        /*
           ZOOM TO DELIVERY
        */

        map.setView(
            [
                latitude,
                longitude
            ],
            17
        );


        /*
           Force Leaflet to recalculate
           the map size.
        */

        setTimeout(
            function () {

                map.invalidateSize();

            },
            200
        );

    }
);

</script>

</body>

</html>
